# =====================================================================
# AI Learning Agent 环境变量样例
# 复制为 .env 后填写真实值；.env 不会也不允许被提交到 Git。
# =====================================================================

# ---------- 应用 ----------
# 运行环境标识，仅用于日志与诊断
APP_ENV=local
# 默认只绑定回环地址；远程访问必须经认证的 HTTPS 反向代理或 VPN
APP_HOST=127.0.0.1
APP_PORT=8000
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ---------- 数据持久化 ----------
DATABASE_URL=sqlite:///./data/app.db

# ---------- 模型（OpenAI 兼容接口，默认 DeepSeek）----------
# 密钥只从环境变量注入，禁止写入源码或提交
MODEL_API_KEY=
MODEL_NAME=deepseek-v4-flash
MODEL_BASE_URL=https://api.deepseek.com/v1
# 单次模型请求超时（秒）与有限重试次数
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=2
# 单次模型调用允许生成的最大 token 数
MODEL_MAX_OUTPUT_TOKENS=2000

# ---------- 文档获取白名单 ----------
# 精确主机名，逗号分隔；不支持通配符，子域必须显式列出。
# 留空表示拒绝一切外部抓取（默认安全）。
# 示例：
# ALLOWED_DOCUMENT_HOSTS=liaoxuefeng.com,platform.openai.com,developers.openai.com,cookbook.openai.com,openai.com,docs.claude.com,docs.anthropic.com,fastapi.tiangolo.com,python.langchain.com,docs.langchain.com,langchain-ai.github.io
ALLOWED_DOCUMENT_HOSTS=
# 允许的目标端口，逗号分隔
ALLOWED_DOCUMENT_PORTS=80,443

# ---------- 文档获取与解析资源限制 ----------
# 连接与读取超时（秒）
FETCH_TIMEOUT_SECONDS=15
# 单次文档获取允许的最大重定向跳数
MAX_REDIRECTS=5
# HTTP 响应体最大字节数
MAX_DOCUMENT_BYTES=2000000
# 清洗后正文最大字符数，超出即截断并标记 truncated
MAX_DOCUMENT_CHARS=60000

# ---------- 单次 Agent Run 限制 ----------
# 单次运行总时限（秒）
RUN_TIMEOUT_SECONDS=120
# 最大模型调用轮数
MAX_MODEL_ROUNDS=6
# 单次运行最大工具调用次数
MAX_TOOL_CALLS=3
# 返回给模型的单个工具结果最大字符数
MAX_TOOL_RESULT_CHARS=20000

# ---------- 上下文与输入限制 ----------
# 提交给模型的上下文最大 token 预算
CONTEXT_MAX_TOKENS=24000
# 最多携带的历史消息条数
MAX_HISTORY_MESSAGES=20
# 单条用户输入最大字符数
MAX_INPUT_CHARS=4000
