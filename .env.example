# =====================================================================
# AI Learning Agent 环境变量样例
# 复制为 .env 后填写真实值；.env 不会也不允许被提交到 Git。
# =====================================================================

# ---------- 应用 ----------
# 运行环境标识，仅用于日志与诊断
APP_ENV=local
# 默认只绑定回环地址；远程访问必须经认证的 HTTPS 反向代理或 VPN
APP_HOST=127.0.0.1
APP_PORT=8000
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ---------- 数据持久化 ----------
DATABASE_URL=sqlite:///./data/app.db

# ---------- 模型（OpenAI 兼容接口，默认 DeepSeek）----------
# 密钥只从环境变量注入，禁止写入源码或提交
MODEL_API_KEY=
MODEL_NAME=deepseek-v4-flash
MODEL_BASE_URL=https://api.deepseek.com/v1
# 单次模型请求超时（秒）与有限重试次数
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=2
# 单次模型调用允许生成的最大 token 数
MODEL_MAX_OUTPUT_TOKENS=2000
# 成本估算单价（元/千 token）；默认 0 表示不计算成本（estimated_cost 保持为空）
MODEL_PRICE_INPUT_PER_1K=0
MODEL_PRICE_OUTPUT_PER_1K=0
# 采样温度（0~2）；不设置则使用服务商默认值。评估回归建议固定为 0
# MODEL_TEMPERATURE=0

# ---------- 文档获取白名单 ----------
# 精确主机名，逗号分隔；不支持通配符，子域必须显式列出。
# 留空表示拒绝一切外部抓取（默认安全）。
# 示例：
# ALLOWED_DOCUMENT_HOSTS=liaoxuefeng.com,platform.openai.com,developers.openai.com,cookbook.openai.com,openai.com,docs.claude.com,docs.anthropic.com,fastapi.tiangolo.com,python.langchain.com,docs.langchain.com,langchain-ai.github.io
ALLOWED_DOCUMENT_HOSTS=
# 允许的目标端口，逗号分隔
ALLOWED_DOCUMENT_PORTS=80,443

# ---------- 文档获取与解析资源限制 ----------
# 连接与读取超时（秒）
FETCH_TIMEOUT_SECONDS=15
# 单次文档获取允许的最大重定向跳数
MAX_REDIRECTS=5
# HTTP 响应体最大字节数
MAX_DOCUMENT_BYTES=2000000
# 清洗后正文最大字符数，超出即截断并标记 truncated
MAX_DOCUMENT_CHARS=60000

# ---------- 单次 Agent Run 限制 ----------
# 单次运行总时限（秒）
RUN_TIMEOUT_SECONDS=120
# 最大模型调用轮数
MAX_MODEL_ROUNDS=6
# 单次运行最大工具调用次数
MAX_TOOL_CALLS=5
# 返回给模型的单个工具结果最大字符数
MAX_TOOL_RESULT_CHARS=20000

# ---------- 知识库（v2 M2）----------
# 是否注册 knowledge 工具；RAG 不可用时 Agent 仍可正常启动
KNOWLEDGE_BASE_ENABLED=true
# RAG 服务地址；与 Agent 同机时建议 RAG 使用 8001
KNOWLEDGE_BASE_URL=http://127.0.0.1:8001
# 连接/读取超时（秒）
KNOWLEDGE_BASE_CONNECT_TIMEOUT_SECONDS=3
KNOWLEDGE_BASE_READ_TIMEOUT_SECONDS=10
# 单次入库请求允许的最大 URL 数
KNOWLEDGE_BASE_MAX_URLS=20
# 入库通知 watcher：扫描间隔、退避上限、单任务最长等待、单批处理数
INGESTION_POLL_INTERVAL_S=2
INGESTION_POLL_MAX_INTERVAL_S=12
INGESTION_WATCH_TIMEOUT_S=1800
INGESTION_MAX_ACTIVE_WATCHES=20

# ---------- 上下文与输入限制 ----------
# 提交给模型的上下文最大 token 预算
CONTEXT_MAX_TOKENS=24000
# 上下文 token 估算的安全系数（1.0~2.0，越大越保守，用于缓解低估导致超出上下文）
CONTEXT_TOKEN_SAFETY_FACTOR=1.15
# 最多携带的历史消息条数
MAX_HISTORY_MESSAGES=20
# 单条用户输入最大字符数
MAX_INPUT_CHARS=4000
